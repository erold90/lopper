{
  "name": "lopper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Compaction that prunes instead of summarizing, for Claude Code and opencode",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p opencode/tsconfig.json",
    "validate": "claude plugin validate plugin/.claude-plugin/plugin.json && claude plugin validate .claude-plugin/marketplace.json",
    "replay": "tsx scripts/replay.ts",
    "replay:opencode": "tsx scripts/replay-opencode.ts",
    "install:opencode": "./opencode/install.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@xterm/xterm": "^6.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
